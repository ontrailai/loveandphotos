# Test Environment Variables
NODE_ENV=test
PORT=3002

# Test database (use test database or mock)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=test_service_key
SUPABASE_ANON_KEY=test_anon_key

# Test payment processing (use test keys)
STRIPE_SECRET_KEY=sk_test_mock_key
STRIPE_PUBLISHABLE_KEY=pk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_test_key

# Test email service
RESEND_API_KEY=re_test_key

# Test storage
STORAGE_BUCKET=test-bucket

# Test feature flags
ENABLE_REAL_PAYMENTS=false
ENABLE_REAL_EMAILS=false
ENABLE_FILE_UPLOADS=false

# Test rate limiting (more permissive for tests)
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=1000