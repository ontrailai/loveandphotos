# Stripe Configuration (TEST MODE ONLY)
# Get your test keys from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (from stripe listen command)
# Run: stripe listen --forward-to localhost:5173/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Site URL for Stripe redirects
SITE_URL=http://localhost:5173

# Existing keys (copy from .env if needed)
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_KEY=your_supabase_service_key

# Cloudflare Stream Video Configuration
# For the "Forever Starts Here" CTA section background video
# Choose one of the following options:

# Option 1: Direct HLS URL (recommended)
VITE_CF_STREAM_HLS=https://customer-XXXXX.cloudflarestream.com/VIDEO_ID/manifest/video.m3u8

# Option 2: Subdomain + Video ID (if not using direct URL)
# VITE_CF_STREAM_SUBDOMAIN=customer-XXXXX.cloudflarestream.com
# VITE_CF_STREAM_VIDEO_ID=your_video_id_here

# Get your Cloudflare Stream credentials:
# 1. Login to https://dash.cloudflare.com
# 2. Navigate to Stream > Videos
# 3. Select your video
# 4. Copy the HLS manifest URL or subdomain and video ID